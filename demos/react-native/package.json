{
  "name": "@cyberscaling/secure-audio-stream-demo-rn",
  "version": "0.0.1",
  "private": true,
  "description": "React Native demo for @cyberscaling/secure-audio-stream-client via react-native-webview.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
