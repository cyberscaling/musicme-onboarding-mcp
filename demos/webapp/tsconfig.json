{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["public/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "public/**/*.ts",
    "tools/**/*.ts",
    "vite.config.ts",
    "../../client/src/**/*.d.ts"
  ]
}
