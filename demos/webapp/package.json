{
  "name": "@secure-audio-stream/webapp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy --env dev",
    "preview": "vite build && wrangler dev --env dev --port 8788 --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "gen-keys": "bun run tools/gen-keys.ts"
  },
  "dependencies": {
    "@cyberscaling/secure-audio-stream-client": "0.5.0",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20251101.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "4.87.0"
  }
}
